local.file_match "errorlens_logs" {
  path_targets = [{
    "__path__" = "/var/log/errorlens/*.log*",
    "job" = "errorlens",
  }]
}

loki.source.file "errorlens_logs" {
  targets    = local.file_match.errorlens_logs.targets
  forward_to = [loki.process.errorlens_logs.receiver]
}

loki.process "errorlens_logs" {
  stage.json {
    expressions = {
      level     = "level",
      component = "component",
      event_name = "event_name",
      event_status = "event_status",
      provider = "provider",
    }
  }

  stage.labels {
    values = {
      level     = "",
      component = "",
      event_name = "",
      event_status = "",
      provider = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}